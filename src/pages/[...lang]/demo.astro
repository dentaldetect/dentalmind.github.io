---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/home/HomeIcon.astro';
import DentalExplorer from '../../components/home/DentalExplorer.astro';
import { site } from '../../data/site';
import { exampleClusters } from '../../data/example-result';
import { t, lp, asset, langPaths, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const x = d.xray;
const l = (en: string, fa: string) => lang === "fa" ? fa : en;
---

<Base lang={lang} title={x.title} description={x.subtitle} active="demo">
  <section class="demo-page">
    <div class="wrap demo-heading">
      <div class="crumb"><a href={lp(lang, '/')}>DentalMind</a><span>/</span><span>{l('ANALYSIS WORKSPACE','فضای بررسی تصویر')}</span></div>
      <div class="heading-row"><div><h1>{l('A clearer view of every tooth.','نمایی روشن‌تر از هر دندان.')}</h1><p>{l('Bring in a radiograph, explore the findings, and keep the next step in perspective.','تصویر رادیوگرافی را انتخاب کنید، یافته‌ها را ببینید و گام بعدی را با آگاهی بیشتری بررسی کنید.')}</p></div><span class="research-badge">{l('Research prototype','نمونه پژوهشی')}</span></div>
      <ol class="workflow"><li><b>01</b>{l('Select an image','انتخاب تصویر')}</li><li><b>02</b>{l('Explore findings','بررسی یافته‌ها')}</li><li><b>03</b>{l('Clinical review','بازبینی بالینی')}</li></ol>
    </div>
    <div
      class="wrap demo"
      id="xray-app"
      data-t={JSON.stringify(x)}
      data-api={site.api}
      data-lang={lang}
      data-example={JSON.stringify(exampleClusters(lang))}
    >
      <div class="col-input">
        <div class="card">
          <h2 class="input-title"><Icon name="scan" size={16}/>{l('Start with an image','با یک تصویر شروع کنید')}</h2>
          <label class="field" for="xr-modality">
            {x.modality}
            <select id="xr-modality">
              {Object.entries(x.modalities).map(([k, v]) => <option value={k}>{v}</option>)}
            </select>
          </label>
          <label class="drop" id="xr-drop" for="xr-file">
            <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M12 16V4m0 0-4 4m4-4 4 4M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="drop-main">{x.choose}</span>
            <span class="muted">{x.drop}</span>
            <input id="xr-file" type="file" accept="image/jpeg,image/png" class="visually-hidden" />
          </label>
          <p class="muted small">{x.privacy}</p>
          {!site.api && <p class="notice">{x.noApi}</p>}

          <div id="xr-checks" hidden>
            <h2 class="h3">{x.checksTitle}</h2>
            <ul id="xr-checks-list" class="checks"></ul>
            <p id="xr-verdict" class="verdict" hidden></p>
          </div>

          <div class="actions">
            <button id="xr-analyse" class="btn btn-primary" type="button" hidden>{x.analyse}</button>
            <button id="xr-example" class="btn btn-ghost" type="button">{x.showExample}</button>
          </div>
          <p id="xr-message" class="message" role="status" hidden></p>
        </div>
        <p class="muted small">{d.disclaimer}</p>
      </div>

      <div class="col-output">
        <div id="xr-empty" class="empty-state">
          <div class="empty-image"><img src={asset('/brand/dental-panorama-synthetic.png')} width="1672" height="941" alt={l('Synthetic panoramic illustration used to preview the workspace','تصویر پانورامیک تولیدشده برای پیش‌نمایش فضای بررسی')} fetchpriority="high"/><span>{l('ILLUSTRATIVE IMAGE · NOT A RESULT','تصویر آموزشی · پیش‌نمایش')}</span></div>
          <h2>{l('Your image. The details in focus.','تصویر شما، با جزئیاتی روشن‌تر.')}</h2><p>{l('Choose the example to explore a tooth-by-tooth review, or upload an image to begin.','نمونه آموزشی را برای بررسی یافته‌های هر دندان انتخاب کنید یا تصویر خود را بارگذاری کنید.')}</p>
          <button id="xr-empty-example" type="button" class="example-link">{x.showExample} <span aria-hidden="true">{lang === 'fa' ? '←' : '→'}</span></button>
        </div>
        <figure id="xr-preview" class="preview" hidden>
          <canvas id="xr-canvas" dir="ltr" aria-label={x.yourImage}></canvas>
        </figure>

        <section id="xr-results" class="results" hidden aria-live="polite">
          <h2 id="xr-results-title" class="h3"></h2>
          <p id="xr-results-note" class="muted small"></p>
          <div id="xr-example-figure" hidden>
            <DentalExplorer lang={lang} />
          </div>
          <div id="xr-clusters" class="clusters"></div>
          <a class="btn btn-ghost" href={lp(lang, '/request-demo/')}>{d.nav.requestDemo}</a>
        </section>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../../scripts/xray-demo';
</script>

<style>
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .demo {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .col-input .card {
    display: grid;
    gap: 16px;
  }
  .field {
    display: grid;
    gap: 6px;
    font-weight: 600;
  }
  select {
    font: inherit;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 10px 12px;
  }
  .drop {
    display: grid;
    justify-items: center;
    gap: 4px;
    text-align: center;
    border: 2px dashed var(--rule);
    border-radius: var(--r);
    padding: 28px 16px;
    cursor: pointer;
    color: var(--teal-600);
    background: var(--surface-2);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .drop:hover,
  .drop[data-over] {
    border-color: var(--teal);
    background: var(--teal-50);
  }
  .drop:focus-within {
    outline: 3px solid var(--teal);
    outline-offset: 2px;
  }
  .drop-main {
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--ink);
  }
  .small {
    font-size: 0.85rem;
    margin: 0;
  }
  .notice,
  .message,
  .verdict {
    border-radius: 10px;
    padding: 10px 12px;
    margin: 0;
    font-size: 0.92rem;
    background: var(--surface-2);
    color: var(--ink-2);
  }
  .message[data-kind='error'],
  .verdict[data-kind='error'] {
    background: #fde8e8;
    color: #9b1c1c;
  }
  .verdict[data-kind='warn'] {
    background: var(--amber-bg);
    color: var(--amber);
  }
  .h3 {
    font-size: 1.15rem;
    margin-block-end: 10px;
  }
  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .checks :global(li) {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
  }
  .checks :global(.chip) {
    min-width: 52px;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 2px 10px;
  }
  .checks :global(.chip-pass) {
    background: var(--ok-bg);
    color: var(--ok-ink);
  }
  .checks :global(.chip-warn) {
    background: var(--amber-bg);
    color: var(--amber);
  }
  .checks :global(.chip-fail) {
    background: #fde8e8;
    color: #9b1c1c;
  }
  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .actions button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }
  .preview {
    margin: 0 0 20px;
  }
  .preview canvas {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--r);
    background: #05080d;
  }
  .results {
    display: grid;
    gap: 14px;
  }
  .results > .btn {
    justify-self: start;
  }
  .clusters {
    display: grid;
    gap: 14px;
  }
  .clusters :global(.cluster) {
    display: grid;
    gap: 8px;
    padding: 18px;
  }
  .clusters :global(.c-head) {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .clusters :global(.c-tooth) {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--navy);
    color: #fff;
    font-weight: 800;
    display: grid;
    place-items: center;
    font-family: 'Inter Variable', Inter, sans-serif;
  }
  .clusters :global(h3) {
    font-size: 1.05rem;
  }
  .clusters :global(h4) {
    font-size: 0.85rem;
    color: var(--ink-3);
    margin: 4px 0 0;
  }
  .clusters :global(.c-meta) {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    font-size: 0.88rem;
  }
  .clusters :global(.sev) {
    font-weight: 700;
    font-size: 0.78rem;
    border-radius: 999px;
    padding: 2px 10px;
  }
  .clusters :global(.sev-critical) {
    background: #fde8e8;
    color: #9b1c1c;
  }
  .clusters :global(.sev-high) {
    background: var(--amber-bg);
    color: var(--amber);
  }
  .clusters :global(.sev-medium) {
    background: var(--gray-bg);
    color: var(--gray-ink);
  }
  .clusters :global(.sev-low) {
    background: var(--ok-bg);
    color: var(--ok-ink);
  }
  .clusters :global(.c-findings),
  .clusters :global(.c-list) {
    margin: 0;
    padding-inline-start: 1.2em;
    color: var(--ink-2);
    font-size: 0.93rem;
  }
</style>

<style>
  .demo-page { background:var(--bg); padding:36px 0 64px; }
  .demo-heading { margin-bottom:28px; }
  .crumb { display:flex; gap:10px; color:var(--ink-3); font-size:10px; letter-spacing:.08em; }
  .heading-row { display:flex; align-items:center; justify-content:space-between; gap:24px; margin:25px 0 30px; }
  .heading-row h1 { font-size:clamp(30px,3.5vw,46px); font-weight:600; letter-spacing:-.04em; }
  .heading-row p { font-size:13px; color:var(--ink-3); line-height:1.85; max-width:590px; margin:13px 0 0; }
  .research-badge { white-space:nowrap; border:1px solid var(--rule); padding:7px 10px; border-radius:6px; color:var(--teal); font-size:10px; }
  .workflow { display:flex; gap:36px; list-style:none; margin:0; padding:17px 0; border-block:1px solid var(--rule); }
  .workflow li { display:flex; align-items:center; gap:9px; font-size:11px; color:var(--ink-3); }
  .workflow b { font-size:9px; color:var(--teal); }
  .demo { grid-template-columns:310px minmax(0,1fr); gap:24px; }
  .col-input .card { padding:19px; box-shadow:none; gap:16px; }
  .input-title { display:flex; align-items:center; gap:8px; font-size:13px; font-weight:600; }
  .field { font-size:10px; color:var(--ink-3); }
  select { font-size:12px; }
  .drop { padding:30px 14px; border-width:1px; background:#f2f5ed; }
  .drop-main { font-size:12px; font-weight:600; }
  .drop .muted { font-size:10px; }
  .small { font-size:10px; line-height:1.85; }
  .notice,.message,.verdict { font-size:11px; line-height:1.8; }
  .actions { display:grid; }
  .actions .btn { font-size:12px; min-height:42px; padding:9px 12px; border-radius:7px; }
  .col-input > p { margin-top:16px; }
  .empty-state { min-height:490px; background:var(--surface); border:1px solid var(--rule); border-radius:13px; padding:28px; text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:center; }
  .empty-image { position:relative; width:min(100%,530px); border-radius:10px; overflow:hidden; margin-bottom:28px; }
  .empty-image img { display:block; width:100%; height:auto; }
  .empty-image > span { position:absolute; bottom:10px; inset-inline-start:10px; color:#e8ede5; background:#12332bc9; padding:4px 7px; font-size:8px; border-radius:4px; }
  .empty-state h2 { font-size:22px; font-weight:550; }
  .empty-state p { max-width:410px; color:var(--ink-3); font-size:12px; line-height:1.85; margin:12px 0 18px; }
  .example-link { display:flex; align-items:center; gap:9px; font:inherit; font-size:12px; font-weight:600; border:0; background:transparent; color:var(--teal); cursor:pointer; padding:8px; }
  .results { gap:16px; }
  .results .h3 { font-weight:600; }
  .clusters :global(.cluster) { box-shadow:none; padding:20px; }
  .clusters :global(.c-tooth) { background:#e6efdd; color:var(--teal); }
  .clusters :global(.c-findings), .clusters :global(.c-list) { font-size:12px; line-height:1.9; }
  .clusters :global(h3) { font-size:15px; font-weight:600; }
  .clusters :global(h4) { font-size:10px; }
  .checks :global(li) { font-size:11px; }
  .preview { border:1px solid var(--rule); border-radius:12px; overflow:hidden; }
  :global([dir="rtl"]) .heading-row h1 { letter-spacing:0; }
  @media(max-width:900px) { .demo { grid-template-columns:270px minmax(0,1fr); gap:18px; } }
  @media(max-width:700px) { .demo { grid-template-columns:1fr; } .heading-row { align-items:flex-start; flex-direction:column; gap:14px; } .empty-state { min-height:370px; padding:20px; } .workflow { gap:23px; } .workflow li { font-size:10px; } }
</style>
