---
import Base from '../../layouts/Base.astro';
import DentalExplorer from '../../components/home/DentalExplorer.astro';
import Icon from '../../components/home/HomeIcon.astro';
import styles from '../../components/home/home.module.css';
import { lp, langPaths, type Lang } from '../../lib/i18n';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const fa = lang === 'fa';
  const copy = fa ? {
    badge: "هوش مصنوعی دندان‌پزشکی · نمونه پژوهشی",
    title: "هر دندان، یک داستان.", accent: "تصویری روشن‌تر از مراقبت.",
    intro: "از تصویر رادیوگرافی تا یافته‌های قابل بررسی برای هر دندان. DentalMind به شما کمک می‌کند نقاط نیازمند توجه را ببینید و گفت‌وگوی درمان را با آگاهی بیشتری آغاز کنید.",
    demo: "دموی تعاملی را ببینید", evidence: "پژوهش و شواهد", explore: "یافته‌ها را در تصویر بررسی کنید",
    note: "ابزار پژوهشی برای پشتیبانی از تصمیم‌گیری. تشخیص و تصمیم درمانی با دندان‌پزشک است.",
    strip: ["شماره‌گذاری هر دندان", "یافته‌ها در بستر تصویر", "بررسی با نظارت دندان‌پزشک"],
    eyebrow: "از دیدن تا درک کردن", heading: "تصویر کامل‌تر. گفت‌وگوی بهتر.",
    sub: "هر یافته به دندان مربوط متصل است؛ با زمینه کافی برای بررسی و تعیین گام بعدی.",
    features: [
      ["ساختار، نه فقط یک کادر", "شماره دندان، موقعیت و یافته احتمالی در کنار هم نمایش داده می‌شوند."],
      ["مشاهده دلیل هر یافته", "با انتخاب هر علامت، ناحیه مورد توجه و زمینه بررسی آن را ببینید."],
      ["گام بعدی با نظر شما", "یافته‌های احتمالی را بررسی و تأیید کنید؛ سپس برنامه مراقبت را تعیین کنید."],
    ],
    workflow: "روند کار", workflowTitle: "از یک تصویر شروع کنید.",
    workflowSub: "پنج نوع تصویربرداری، یک مسیر مشخص برای بررسی.",
    steps: [["بارگذاری تصویر", "تصویر یا نمونه را در فضای دمو انتخاب کنید."], ["بررسی یافته‌ها", "یافته‌های احتمالی را در تصویر و به تفکیک دندان ببینید."], ["تصمیم با دندان‌پزشک", "یافته‌ها همراه با معاینه و سابقه بیمار بررسی می‌شوند."]],
    modalities: ["بایت‌وینگ", "پانورامیک", "پری‌اپیکال", "سری کامل دهان", "CBCT"],
    end: "از یک تصویر، به گفت‌وگویی روشن‌تر برسید.", endSub: "دمو را بررسی کنید یا درباره کاربرد پژوهشی DentalMind با ما صحبت کنید.", contact: "درخواست نمایش محصول",
  } : {
    badge: "DENTAL INTELLIGENCE · RESEARCH PROTOTYPE",
    title: "Every tooth tells a story.", accent: "See the whole picture.",
    intro: "Turn a dental X-ray into a clearer conversation. Explore potential findings, understand each tooth, and bring the next step into focus—with the dentist in control.",
    demo: "Explore the demo", evidence: "See the evidence", explore: "Select a finding. See the connection.",
    note: "A research prototype for decision support. Diagnosis and treatment decisions remain with the dentist.",
    strip: ["Tooth-by-tooth context", "Findings you can explore", "Dentist-led decisions"],
    eyebrow: "MORE THAN A MARK ON AN X-RAY", heading: "A clearer picture. A better conversation.",
    sub: "Keep the tooth, the potential finding, and the next review step connected.",
    features: [
      ["Anatomy with context", "Tooth numbers and potential findings come together in one connected view."],
      ["See what needs a closer look", "Explore each highlighted area and the context behind the observation."],
      ["A considered next step", "Review and confirm potential findings before building a dentist-led care plan."],
    ],
    workflow: "A SIMPLE, CONNECTED WORKFLOW", workflowTitle: "One image. A more informed next step.",
    workflowSub: "Five imaging modalities. One considered review workflow.",
    steps: [["Bring in the image", "Upload a study or explore a sample in the demo."], ["Explore the findings", "Review potential findings on the image, grouped by tooth."], ["Put it in context", "The dentist reviews the findings alongside the examination and patient history."]],
    modalities: ["Bitewing", "Panoramic", "Periapical", "Full-mouth series", "CBCT"],
    end: "Better conversations start with a clearer picture.", endSub: "Explore the demo or talk with us about DentalMind’s research workflow.", contact: "Request a demo",
  };
---
<Base lang={lang}>
  <div class={styles.home}>
    <section class={styles.hero}>
      <div class={styles.heroGrid}>
        <div class={styles.heroCopy}>
          <div class={styles.eyebrow}><span class={styles.statusDot}/>{copy.badge}</div>
          <h1>{copy.title}<span>{copy.accent}</span></h1>
          <p class={styles.intro}>{copy.intro}</p>
          <div class={styles.actions}>
            <a class={styles.primaryButton} href={lp(lang, '/demo/')}>{copy.demo}<Icon name="arrow" size={17} class={styles.directional}/></a>
            <a class={styles.textButton} href={lp(lang, '/evidence/')}>{copy.evidence}<Icon name="arrow" size={16} class={styles.directional}/></a>
          </div>
          <a class={styles.exploreHint} href="#dental-explorer"><span><Icon name="down" size={15}/></span>{copy.explore}</a>
          <p class={styles.researchNote}>{copy.note}</p>
        </div>
        <DentalExplorer lang={lang}/>
      </div>
      <div class={styles.promiseStrip}>{copy.strip.map(item => <span><Icon name="check" size={16}/>{item}</span>)}</div>
    </section>
    <section id="features" class={styles.features}>
      <div class={styles.sectionHeading}><p class={styles.eyebrow}>{copy.eyebrow}</p><h2>{copy.heading}</h2><p>{copy.sub}</p></div>
      <div class={styles.featureGrid}>{copy.features.map(([title, body], i) => <article><span class={styles.featureIcon}><Icon name={['layers','scan','file'][i]} size={23}/></span><span class={styles.featureIndex}>0{i + 1}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
    </section>
    <section id="how-it-works" class={styles.workflow}>
      <div><p class={styles.eyebrow}>{copy.workflow}</p><h2>{copy.workflowTitle}</h2><p>{copy.workflowSub}</p><div class={styles.modalities}>{copy.modalities.map(item => <span>{item}</span>)}</div></div>
      <ol>{copy.steps.map(([title, body], i) => <li><span>0{i + 1}</span><div><h3>{title}</h3><p>{body}</p></div></li>)}</ol>
    </section>
    <section class={styles.finalCta}><div><span class={styles.eyebrow}>DENTALMIND</span><h2>{copy.end}</h2><p>{copy.endSub}</p></div><a href={lp(lang, '/request-demo/')} class={styles.primaryButton}>{copy.contact}<Icon name="arrow" size={18} class={styles.directional}/></a></section>
  </div>
</Base>
