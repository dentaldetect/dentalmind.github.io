---
import Page from '../../../layouts/Page.astro';
import { t, lp, langPaths, dir, type Lang } from '../../../lib/i18n';
import { getPosts, postLang, postDate, readTime } from '../../../lib/blog';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const posts = await getPosts(lang);
---

<Page lang={lang} title={d.blog.title} subtitle={d.blog.subtitle} active="blog">
  <section class="section">
    <div class="wrap grid grid-3">
      {posts.map((p) => {
        const pl = postLang(p);
        return (
          <a class="card post" href={lp(lang, `/blog/${p.id}/`)} lang={pl} dir={dir(pl)}>
            <span class="tag">{p.data.tag}</span>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <span class="muted meta">{postDate(pl, p.data.date)} · {readTime(pl, p.data.minutes)}</span>
          </a>
        );
      })}
    </div>
  </section>
</Page>

<style>
  .post {
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .post:hover {
    text-decoration: none;
    border-color: var(--teal);
  }
  .tag {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--teal-600);
    background: var(--teal-50);
    border-radius: 999px;
    padding: 2px 10px;
  }
  h2 {
    font-size: 1.2rem;
  }
  p {
    color: var(--ink-2);
    margin: 0;
    flex: 1;
  }
  .meta {
    font-size: 0.85rem;
  }
</style>
