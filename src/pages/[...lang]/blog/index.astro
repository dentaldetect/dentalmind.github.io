---
import { getCollection } from 'astro:content';
import Page from '../../../layouts/Page.astro';
import { t, lp, langPaths, int, type Lang } from '../../../lib/i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const date = (x: Date) => new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium' }).format(x);
---

<Page lang={lang} title={d.blog.title} subtitle={d.blog.subtitle} active="blog">
  {lang === 'fa' && <p slot="head" class="note">{d.blog.englishOnly}</p>}
  <section class="section">
    <div class="wrap grid grid-3">
      {posts.map((p) => (
        <a class="card post" href={lp(lang, `/blog/${p.id}/`)} lang="en" dir="ltr">
          <span class="tag">{p.data.tag}</span>
          <h2>{p.data.title}</h2>
          <p>{p.data.description}</p>
          <span class="muted meta">{date(p.data.date)} · {int('en', p.data.minutes)} min read</span>
        </a>
      ))}
    </div>
  </section>
</Page>

<style>
  .note {
    font-size: 0.95rem !important;
  }
  .post {
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .post:hover {
    text-decoration: none;
    border-color: var(--teal);
  }
  .tag {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--teal-600);
    background: var(--teal-50);
    border-radius: 999px;
    padding: 2px 10px;
  }
  h2 {
    font-size: 1.2rem;
  }
  p {
    color: var(--ink-2);
    margin: 0;
    flex: 1;
  }
  .meta {
    font-size: 0.85rem;
  }
</style>
