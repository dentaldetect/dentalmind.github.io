---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { t, lp, langs, dir, type Lang } from '../../../lib/i18n';
import { getPosts, postLang, postDate, readTime, type Post } from '../../../lib/blog';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of langs) {
    for (const post of await getPosts(lang)) {
      paths.push({ params: { lang: lang === 'en' ? undefined : lang, slug: post.id }, props: { lang, post } });
    }
  }
  return paths;
}
const { lang, post } = Astro.props as { lang: Lang; post: Post };
const d = t(lang);
const pl = postLang(post);
const { Content } = await render(post);
---

<Base lang={lang} title={post.data.title} description={post.data.description} active="blog">
  <article class={`wrap article ${pl}`} lang={pl} dir={dir(pl)}>
    <a class="back" href={lp(lang, '/blog/')}>{pl === 'fa' ? '→' : '←'} {t(pl).blog.back}</a>
    <span class="tag">{post.data.tag}</span>
    <h1>{post.data.title}</h1>
    <p class="lede">{post.data.description}</p>
    <p class="muted meta">{postDate(pl, post.data.date, 'long')} · {readTime(pl, post.data.minutes)}</p>
    <div class="prose"><Content /></div>
    <p class="muted disc">{d.disclaimer}</p>
  </article>
</Base>

<style>
  .article {
    max-width: 760px;
    padding-block: 48px 24px;
    line-height: 1.75;
  }
  .article.en {
    font-family: 'Inter Variable', Inter, sans-serif;
  }
  .article.fa {
    font-family: 'Vazirmatn Variable', Vazirmatn, Tahoma, sans-serif;
    line-height: 2;
  }
  .back {
    display: inline-block;
    font-weight: 600;
    margin-block-end: 24px;
  }
  .tag {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--teal-600);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .fa .tag {
    letter-spacing: 0;
    font-size: 0.9rem;
  }
  h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    margin-block: 8px 12px;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .fa h1 {
    line-height: 1.55;
    letter-spacing: 0;
  }
  .lede {
    font-size: 1.15rem;
    color: var(--ink-2);
    margin: 0;
  }
  .meta {
    font-size: 0.9rem;
    border-block-end: 1px solid var(--rule);
    padding-block-end: 16px;
  }
  .prose {
    font-size: 1.07rem;
  }
  .prose :global(h2) {
    font-size: 1.45rem;
    margin-block: 32px 8px;
    line-height: 1.35;
  }
  .prose :global(blockquote) {
    margin: 20px 0;
    padding: 10px 16px;
    border-inline-start: 4px solid var(--teal);
    background: var(--teal-50);
    border-start-end-radius: 10px;
    border-end-end-radius: 10px;
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  .prose :global(li) {
    margin-block: 6px;
  }
  .disc {
    font-size: 0.85rem;
    border-block-start: 1px solid var(--rule);
    padding-block-start: 16px;
    margin-block-start: 32px;
  }
</style>
