---
import Page from '../../layouts/Page.astro';
import { site } from '../../data/site';
import { t, langPaths, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const f = d.demo;
const issueUrl = `${site.repo}/issues/new?title=${encodeURIComponent(lang === 'fa' ? 'درخواست دمو' : 'Demo request')}`;
---

<Page lang={lang} title={f.title} subtitle={f.subtitle}>
  <section class="section">
    <div class="wrap layout">
      <div class="card form-card">
        {site.formEndpoint ? (
          <form action={site.formEndpoint} method="POST">
            <div class="row">
              <label>{f.name}<input name="name" required autocomplete="name" /></label>
              <label>{f.email}<input name="email" type="email" required autocomplete="email" dir="ltr" /></label>
            </div>
            <div class="row">
              <label>{f.org}<input name="organization" autocomplete="organization" /></label>
              <label>{f.city}<input name="city" /></label>
            </div>
            <label>{f.role}
              <select name="role">{f.roles.map((r) => <option>{r}</option>)}</select>
            </label>
            <label>{f.message}<textarea name="message" rows="5"></textarea></label>
            <input type="hidden" name="language" value={lang} />
            <p class="muted small">{f.privacy}</p>
            <button class="btn btn-primary" type="submit">{f.submit}</button>
          </form>
        ) : (
          <div class="fallback">
            <p>{f.noEndpoint}</p>
            <a class="btn btn-primary" href={issueUrl} rel="noopener">{f.openIssue}</a>
            <p class="muted small">{f.privacy}</p>
          </div>
        )}
      </div>
      <aside class="side">
        <div class="card">
          <h2>{d.home.stepsTitle}</h2>
          <ol>{d.home.steps.map((s) => <li><b>{s.title}.</b> {s.text}</li>)}</ol>
        </div>
        {site.appUrl && (
          <div class="card">
            <h2>{f.appTitle}</h2>
            <p>{f.appText}</p>
            <a class="btn btn-ghost" href={site.appUrl} rel="noopener">{d.nav.openApp}</a>
          </div>
        )}
        <p class="muted small">{d.disclaimer}</p>
      </aside>
    </div>
  </section>
</Page>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  form {
    display: grid;
    gap: 16px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
  label {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  input,
  select,
  textarea {
    font: inherit;
    font-weight: 400;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 10px 12px;
  }
  .fallback p:first-child {
    font-size: 1.05rem;
    color: var(--ink-2);
    margin-block-start: 0;
  }
  .small {
    font-size: 0.85rem;
  }
  .side {
    display: grid;
    gap: 16px;
  }
  .side h2 {
    font-size: 1.15rem;
    margin-block-end: 8px;
  }
  .side ol {
    margin: 0;
    padding-inline-start: 1.2em;
    color: var(--ink-2);
  }
  .side li {
    margin-block: 8px;
  }
  .side p {
    color: var(--ink-2);
  }
</style>
