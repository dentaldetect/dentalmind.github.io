---
import Page from '../../layouts/Page.astro';
import StatusChip from '../../components/StatusChip.astro';
import { t, lp, langPaths, num, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const p = d.product;
const sevClass = (s: string) =>
  ({ Low: 'low', کم: 'low', Medium: 'med', متوسط: 'med', High: 'high', زیاد: 'high', Critical: 'crit', بحرانی: 'crit' })[s] ?? '';
---

<Page lang={lang} title={p.title} subtitle={p.subtitle} active="product">
  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>{p.modalitiesTitle}</h2></div>
      <div class="grid grid-3 mods">
        {p.modalities.map((m) => (
          <div class="card">
            <h3>{m.name}</h3>
            <p>{m.text}</p>
            <StatusChip lang={lang} status={m.status} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="section-head"><h2>{p.stagesTitle}</h2></div>
      <ol class="pipeline">
        {p.stages.map((s, i) => (
          <li id={s.id} class="card stage">
            <span class="n">{num(lang, i + 1, 0)}</span>
            <div>
              <div class="stage-top">
                <h3>{s.title}</h3>
                <StatusChip lang={lang} status={s.status} />
              </div>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <h2 class="h2">{p.patternsTitle}</h2>
        <div class="table-scroll card flush">
          <table class="data">
            <thead><tr>{p.patternsCols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
            <tbody>
              {p.patterns.map(([pat, sev, urg]) => (
                <tr><td>{pat}</td><td><span class={`sev ${sevClass(sev)}`}>{sev}</span></td><td>{urg}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div>
        <h2 class="h2">{p.outputTitle}</h2>
        <ul class="checks">
          {p.outputs.map((o) => <li>{o}</li>)}
        </ul>
        <a class="btn btn-primary" href={lp(lang, '/request-demo/')}>{d.nav.requestDemo}</a>
      </div>
    </div>
  </section>
</Page>

<style>
  .mods h3,
  .stage h3 {
    font-size: 1.12rem;
  }
  .mods p,
  .stage p {
    color: var(--ink-2);
    margin: 6px 0 12px;
  }
  .alt {
    background: var(--surface-2);
  }
  .pipeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .stage {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 16px;
    scroll-margin-top: 90px;
  }
  .stage p {
    margin-block-end: 0;
  }
  .stage-top {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .n {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--teal);
    color: #fff;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .two {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 40px;
  }
  @media (max-width: 860px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
  .h2 {
    font-size: 1.6rem;
    margin-block-end: 16px;
  }
  .flush {
    padding: 0;
  }
  .sev {
    font-weight: 700;
    font-size: 0.85rem;
    border-radius: 999px;
    padding: 2px 10px;
  }
  .sev.low {
    background: var(--ok-bg);
    color: var(--ok-ink);
  }
  .sev.med {
    background: var(--gray-bg);
    color: var(--gray-ink);
  }
  .sev.high {
    background: var(--amber-bg);
    color: var(--amber);
  }
  .sev.crit {
    background: #fde8e8;
    color: #b91c1c;
  }
  .checks {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
  }
  .checks li {
    padding: 8px 0;
    padding-inline-start: 30px;
    position: relative;
    border-block-end: 1px dashed var(--rule);
  }
  .checks li::before {
    content: '✓';
    position: absolute;
    inset-inline-start: 4px;
    color: var(--teal);
    font-weight: 800;
  }
</style>
