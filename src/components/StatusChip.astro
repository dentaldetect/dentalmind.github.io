---
import { t, type Lang } from '../lib/i18n';
interface Props {
  lang: Lang;
  status: string;
}
const { lang, status } = Astro.props;
const label = t(lang).status[status as keyof ReturnType<typeof t>['status']] ?? status;
---

<span class={`chip chip-${status}`}>{label}</span>

<style>
  .chip {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 2px 10px;
    white-space: nowrap;
  }
  .chip-validated {
    background: var(--ok-bg);
    color: var(--ok-ink);
  }
  .chip-research {
    background: var(--gray-bg);
    color: var(--gray-ink);
  }
  .chip-experimental {
    background: var(--amber-bg);
    color: var(--amber);
  }
</style>
